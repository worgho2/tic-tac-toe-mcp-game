{
  "name": "tic-tac-toe-mcp-game",
  "version": "0.2.0",
  "description": "Two-player tic-tac-toe that renders as an interactive MCP App inside your AI chat client.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Otávio Baziewicz Filho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worgho2/tic-tac-toe-mcp-game.git"
  },
  "homepage": "https://github.com/worgho2/tic-tac-toe-mcp-game#readme",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -n ui,server -c cyan,green \"vite build --watch\" \"tsx watch src/server/main.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "30.0.1",
    "lefthook": "^2.1.14",
    "storybook": "10.6.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  }
}
